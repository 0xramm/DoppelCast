{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DoppelCast",
  "version": "1.1.0",
  "identifier": "com.doppelcast.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DoppelCast",
        "width": 820,
        "height": 540,
        "minWidth": 640,
        "minHeight": 460,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0NzZGQTczNzc1OTUwNjUKUldSbFVGbDNjL3AyWkIvcE81c3Q1dEhwWmNab2RWTUpMRUJHZ2R6d0xKUmZFeFhacElGWENac3gK",
      "endpoints": [
        "https://github.com/0xramm/DoppelCast/releases/latest/download/latest.json"
      ]
    }
  }
}
